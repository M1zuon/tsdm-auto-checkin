# 统一按 LF 入库，避免 Windows/Linux 之间的 diff 噪音
* text=auto eol=lf

*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.html  text eol=lf
*.xml   text eol=lf

# 二进制文件不要做行尾转换
*.png   binary
*.jpg   binary
*.gif   binary
*.zip   binary

# 语言统计
*.js    linguist-language=JavaScript
