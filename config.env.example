# TSDM 天使动漫 自动签到 / 打工 · 环境变量模板
# 复制为 config.env 后填写（青龙/白虎直接在面板的「环境变量」里逐条添加即可，不需要这个文件）
#
# 本地自测用法（Node 18+）：
#   Windows(PowerShell):  Get-Content config.env | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { Set-Item "Env:$($matches[1])" $matches[2] } }
#   Linux/Bash:           set -a; . ./config.env; set +a
#   Node 20.6+ 直接读取:   node --env-file=config.env tsdm_checkin.js

# ============ 必填 ============
# 浏览器里复制的完整 Cookie（F12 → Network → 任一请求 → Request Headers → Cookie）
# 必须包含 <前缀>_saltkey 与 <前缀>_auth（tsdm39.com 的前缀是 Ystv_2132_）。
# 多账号：用回车换行分隔（面板里粘贴时直接换行即可），不能用分号分隔。
# cf_clearance 可选：默认会被主动剔除（见 TSDM_REQUIRE_CF）。
TSDM_COOKIE=

# ============ 通道与网络 ============
# User-Agent。留空则用内置的「手机端 Chrome」UA；若日志报 Cloudflare 盾页，
# 请填成你复制 Cookie 时那个浏览器的完整 UA。
TSDM_UA=

# 是否保留 Cookie 里的 cf_clearance。
# 0（默认）= 剔除。它与 IP/UA 绑定，带上不匹配的过期值反而更容易触发人机验证。
# 1 = 保留（当页面确实要求过验证时使用）。
TSDM_REQUIRE_CF=0

# 固定通道，留空 = 自动探测 desktop → mobile-ua → mobile-tpl。
#   desktop    桌面 UA（不带 cf_clearance）
#   mobile-ua  手机 UA（贴近官方 App 的设备指纹）
#   mobile-tpl 手机 UA + 移动版模板参数（mobile=2）
TSDM_CHANNEL=

# HTTP(S) 代理，让脚本出口 IP 与取 Cookie 的浏览器一致，例如 http://127.0.0.1:7890
TSDM_PROXY=

# 站点地址（一般不用改；备用域名时才需要）
TSDM_BASE=https://www.tsdm39.com

# ============ 签到参数（只有 tsdm_checkin.js 使用）============
# 心情：kx/ng/ym/wl/nu/ch/fd/yl/shuai，填 random 则每次随机（默认 ym）
TSDM_QDXQ=ym
# 今天最想说的话：填了就用自己的（3~50 字），留空则用「快速语句」
TSDM_TODAYSAY=
# 快速语句编号 1~8（仅在 TSDM_TODAYSAY 为空时生效），留空则随机
TSDM_FASTREPLY=

# ============ 打工参数（只有 tsdm_work.js 使用）============
# 点击广告的随机间隔（毫秒），抓包实测真实点击间隔 1~2 秒
TSDM_WORK_CLICK_MIN_MS=1200
TSDM_WORK_CLICK_MAX_MS=2600
# 遇到「不要作弊」或点击计数异常时，整轮重开的次数上限
TSDM_WORK_ROUNDS=3

# ============ 通用执行参数 ============
TSDM_TIMEOUT_MS=20000
TSDM_RETRY=2
TSDM_DELAY_BETWEEN_MS=1500
# 1 = 只打印执行计划，不发任何网络请求（部署前自检用）
TSDM_DRY_RUN=0
# 1 = 打印调试信息（Cookie 已打码）
TSDM_DEBUG=0

# ============ 通知 ============
# 总开关：1/true 开启，0/false 关闭
TSDM_NOTIFY=1
# 成功时是否推送（只想在失败时被打扰就设 0）
TSDM_NOTIFY_ON_SUCCESS=1
# 失败时是否推送
TSDM_NOTIFY_ON_FAILURE=1
# 通知标题前缀，留空则用「TSDM签到」/「TSDM打工」
TSDM_NOTIFY_TITLE=

# --- Server酱（推荐：纯 HTTP 直发，不经过 Python，无需装 requests）---
# 填 SendKey 本身即可，不要带域名或 /send/。
#   Server酱³：sctp{uid}t...（形如 sctp4247txxxx）→ 自动走 {uid}.push.ft07.com
#   Turbo    ：SCT...                        → 走 sctapi.ftqq.com
# 青龙里也可以直接复用既有的 PUSH_KEY（TSDM_SERVERCHAN_KEY 未设时取它）。
TSDM_SERVERCHAN_KEY=
# 自建/中转 Server酱 时覆盖端点，留空用官方域名
TSDM_SERVERCHAN_URL=
# 兼容青龙既有变量名
PUSH_KEY=

# --- 白虎面板（三件套，在「消息推送 → 脚本调用说明」里可以整段复制）---
# BHPKG_NOTIFY_URL 一般不用填，默认 http://localhost:8052/api/v1/notify/send
BHPKG_NOTIFY_URL=
BHPKG_NOTIFY_TOKEN=
# 渠道 ID，留空则用白虎里的默认渠道；也可用 TSDM_NOTIFY_CHANNEL
BHPKG_NOTIFY_CHANNEL=
TSDM_NOTIFY_CHANNEL=

# --- 青龙面板 ---
# 青龙自带 notify.py，脚本会自动从 $QL_DIR 推导（默认 /ql/data/scripts/notify.py）。
# 只有路径非标准时才需要填。
TSDM_QL_NOTIFY_PATH=
# 青龙容器内的 python 可执行文件（默认 python3）
TSDM_PYTHON=python3

# --- 通用兜底：自定义 Webhook（POST JSON {"title":..,"content":..}）---
TSDM_WEBHOOK_URL=

